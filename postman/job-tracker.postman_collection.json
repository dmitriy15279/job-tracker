      "name": "2. Gateway: list, pagination, filters",
      "description": "Filtering and pagination run in job-tracker; the gateway forwards the parameters.",
      "item": [
        {
          "name": "List: defaults",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gateway}}/api/job-applications",
              "host": [
