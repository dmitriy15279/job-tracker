        {
          "name": "Create: missing appliedDate",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{gateway}}/api/job-applications",
              "host": [
                "{{gateway}}"
              ],
              "path": [
                "api",
                "job-applications"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"company\": \"X\",\n  \"position\": \"QA\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"400 Bad Request\", () => pm.response.to.have.status(400));",
                  "  pm.test(\"field error for appliedDate\", () =>",
                  "      pm.expect(pm.response.json().errors.map(e => e.field)).to.include(\"appliedDate\"));"
                ]
              }
            }
          ]
        }
      ]
