                  "const b = pm.response.json();",
                  "pm.test(\"page 0, size 20\", () => { pm.expect(b.page).to.eql(0); pm.expect(b.size).to.eql(20); });",
                  "pm.test(\"content not larger than size\", () => pm.expect(b.content.length).to.be.at.most(20));",
                  "pm.test(\"totalPages consistent\", () => pm.expect(b.totalPages).to.eql(Math.ceil(b.totalElements / 20)));"
                ]
              }
            }
          ]
        },
