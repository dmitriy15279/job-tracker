    {
      "name": "3. Gateway: seeding",
      "description": "Random applications are created one by one through job-tracker.\nTo see the 503: `docker-compose stop app`, send \"Seed 20\", then `docker-compose start app`.",
      "item": [
        {
          "name": "Total before seeding",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gateway}}/api/job-applications?size=1",
              "host": [
                "{{gateway}}"
              ],
              "path": [
                "api",
                "job-applications"
              ],
              "query": [
                {
                  "key": "size",
                  "value": "1"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set(\"totalBefore\", pm.response.json().totalElements);"
                ]
              }
            }
          ]
        },
        {
          "name": "Seed 20",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{gateway}}/api/job-applications/seed?count=20",
              "host": [
                "{{gateway}}"
              ],
              "path": [
                "api",
                "job-applications",
                "seed"
              ],
              "query": [
                {
