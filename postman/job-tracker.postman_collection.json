{
  "info": {
    "_postman_id": "cec439c3-6369-4ea9-83c9-4ae187d874aa",
    "name": "Job Tracker",
    "description": "End-to-end checks for job-tracker (:8080) and job-tracker-gateway (:8081).\nStart the stack with `docker-compose up -d`, select the \"Job Tracker local\" environment and use Run collection.\nRequests create test data (companies prefixed with \"Postman-<timestamp>\" plus random seeded rows).\nNot covered here (see folder descriptions): WebSocket delivery and the 503 when job-tracker is down.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "0. Health",
      "description": "Both services must be UP before running the rest.",
      "item": [
        {
          "name": "Gateway health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gateway}}/actuator/health",
              "host": [
                "{{gateway}}"
              ],
              "path": [
                "actuator",
                "health"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "pm.test(\"status UP\", () => pm.expect(pm.response.json().status).to.eql(\"UP\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "job-tracker health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{tracker}}/actuator/health",
              "host": [
                "{{tracker}}"
              ],
              "path": [
                "actuator",
                "health"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "pm.test(\"status UP\", () => pm.expect(pm.response.json().status).to.eql(\"UP\"));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "1. Gateway: create and get by id",
      "description": "Single application is created through the gateway and validated by job-tracker.",
      "item": [
        {
          "name": "Create application",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{gateway}}/api/job-applications",
              "host": [
                "{{gateway}}"
              ],
              "path": [
                "api",
                "job-applications"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"company\": \"{{runTag}} Alpha\",\n  \"position\": \"Backend Developer\",\n  \"appliedDate\": \"{{pastDate}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Unique tag per run so the filter checks below see only this run's data",
                  "  pm.collectionVariables.set(\"runTag\", \"Postman-\" + Date.now());",
                  "  const d = new Date(); d.setDate(d.getDate() - 5);",
                  "  pm.collectionVariables.set(\"pastDate\", d.toISOString().slice(0, 10));",
                  "  const f = new Date(); f.setDate(f.getDate() + 5);",
                  "  pm.collectionVariables.set(\"futureDate\", f.toISOString().slice(0, 10));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"201 Created\", () => pm.response.to.have.status(201));",
                  "  const body = pm.response.json();",
                  "  pm.test(\"has numeric id\", () => pm.expect(body.id).to.be.a(\"number\"));",
                  "  pm.test(\"Location header points to the new id\", () =>",
                  "      pm.expect(pm.response.headers.get(\"Location\")).to.eql(\"/api/job-applications/\" + body.id));",
                  "  pm.test(\"echoes fields\", () => {",
                  "      pm.expect(body.company).to.eql(pm.collectionVariables.get(\"runTag\") + \" Alpha\");",
                  "      pm.expect(body.appliedDate).to.eql(pm.collectionVariables.get(\"pastDate\"));",
                  "  });",
                  "  pm.collectionVariables.set(\"createdId\", body.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Create second application (for filters)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{gateway}}/api/job-applications",
              "host": [
                "{{gateway}}"
              ],
              "path": [
                "api",
                "job-applications"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"company\": \"{{runTag}} beta\",\n  \"position\": \"QA Engineer\",\n  \"appliedDate\": \"{{pastDate}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"201 Created\", () => pm.response.to.have.status(201));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get by id",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gateway}}/api/job-applications/{{createdId}}",
              "host": [
                "{{gateway}}"
              ],
              "path": [
                "api",
                "job-applications",
                "{{createdId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "pm.test(\"same application\", () => pm.expect(pm.response.json().id).to.eql(Number(pm.collectionVariables.get(\"createdId\"))));"
                ]
              }
            }
          ]
        },
