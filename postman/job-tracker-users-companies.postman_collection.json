  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Ids are filled in by earlier requests; fail fast with a clear message if one hasn't run yet",
          "const text = pm.request.url.toString() + (pm.request.body && pm.request.body.raw ? pm.request.body.raw : '');",
          "const missing = [...text.matchAll(/{{(\\w+Id)}}/g)].map(m => m[1]).filter(v => !pm.variables.get(v));",
          "if (missing.length) {",
          "    throw new Error('Variable(s) ' + missing.join(', ') + ' are empty - run the request that creates them first (see folders 1 and 2), or use Run collection.');",
          "}"
        ]
      }
    }
  ]
